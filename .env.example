# Project Settings
PROJECT_NAME="Enterprise Knowledge Assistant (EKA)"
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=JSON

# Security
# In production, this MUST be a long, random string
SECRET_KEY=development_secret_key_change_me_in_production

# CORS Origins (JSON list or comma-separated string)
# BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eka_db
POSTGRES_PORT=5432
# If SQLALCHEMY_DATABASE_URI is provided, it overrides individual POSTGRES_* variables
# SQLALCHEMY_DATABASE_URI=postgresql://postgres:postgres@localhost:5432/eka_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# AI Models
# Provide your API keys here
OPENAI_API_KEY=
GEMINI_API_KEY=
